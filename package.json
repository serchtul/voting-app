{
  "name": "voting-app",
  "version": "0.1.0",
  "private": true,
  "engineStrict": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "db:codegen": "kysely-codegen --dialect libsql --url \"env(TURSO_DATABASE_URL)\" --exclude-pattern=\"(account|session|verification)\" --out-file ./src/db/db.d.ts",
    "user:create": "tsx --env-file .env scripts/create-users.ts",
    "db:seed": "tsx --env-file .env scripts/seed-dev.ts",
    "votes:reset": "tsx --env-file .env scripts/reset-votes.ts",
    "votes:count": "tsx --env-file .env scripts/count-ballots.ts"
  },
  "dependencies": {
    "@libsql/kysely-libsql": "^0.4.1",
    "@radix-ui/react-alert-dialog": "^1.1.6",
    "@radix-ui/react-dialog": "^1.1.6",
    "@radix-ui/react-progress": "^1.1.2",
    "@radix-ui/react-select": "^2.1.6",
    "@radix-ui/react-slot": "^1.1.2",
    "@radix-ui/react-tooltip": "^1.1.8",
    "better-auth": "^1.7.7",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "core-js": "^3.41.0",
    "immer": "^10.1.1",
    "kysely": "^0.29.9",
    "lucide-react": "~0.483.0",
    "nanoid": "^5.1.16",
    "next": "^15.5.29",
    "pusher": "^5.2.0",
    "pusher-js": "^8.4.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.0.1",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4.0.6",
    "@types/node": "^22.13.4",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9.20.1",
    "eslint-config-next": "^15.0.4",
    "eslint-config-prettier": "^10.1.1",
    "eslint-plugin-prettier": "^5.2.3",
    "kysely-codegen": "^0.20.0",
    "kysely-ctl": "^0.22.0",
    "postcss": "^8.5.2",
    "prettier": "3.5.3",
    "tailwindcss": "^4.0.6",
    "tsx": "^4.19.3",
    "typescript": "^5"
  },
  "overrides": {
    "kysely-codegen": {
      "shelljs": "^0.9"
    }
  }
}
