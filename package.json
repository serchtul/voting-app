{
  "name": "voting-app",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.23.0",
  "engineStrict": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "db:codegen": "kysely-codegen --dialect libsql --url \"env(TURSO_DATABASE_URL)\" --exclude-pattern=\"(account|session|verification)\" --out-file ./src/db/db.d.ts",
    "user:create": "tsx --env-file .env scripts/create-users.ts",
    "db:seed": "tsx --env-file .env scripts/seed-dev.ts",
    "votes:reset": "tsx --env-file .env scripts/reset-votes.ts",
    "votes:count": "tsx --env-file .env scripts/count-ballots.ts"
  },
  "dependencies": {
    "@libsql/kysely-libsql": "^0.4.1",
    "@radix-ui/react-alert-dialog": "^1.2.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-progress": "^1.2.1",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-tooltip": "^1.4.1",
    "better-auth": "^1.7.27",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "core-js": "^3.51.0",
    "immer": "^10.2.0",
    "kysely": "^0.29.9",
    "lucide-react": "~0.483.0",
    "nanoid": "^5.1.16",
    "next": "^16.4.6",
    "pusher": "^5.3.4",
    "pusher-js": "^8.6.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.7.1",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.6",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "kysely-codegen": "^0.20.0",
    "kysely-ctl": "^0.22.0",
    "postcss": "^8.5.33",
    "prettier": "3.5.3",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
